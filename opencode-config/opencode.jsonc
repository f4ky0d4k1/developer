{
  "$schema": "https://opencode.ai/config.json",
  "provider": {
    "deepseek": {
      "name": "DeepSeek",
      "options": {
        "baseURL": "https://api.deepseek.com",
        // Запрос к модели не дольше 10 мин, и не более 2 мин паузы между чанками стрима.
        // Залипший вызов DeepSeek рвётся сайдкаром → оркестратор видит ошибку и ретраит узел
        // (иначе ран висел до opencode.timeout-seconds вслепую).
        "timeout": 600000,
        "chunkTimeout": 120000
      },
      "models": {
        "deepseek-v4-pro": {},
        "deepseek-flash": {}
      }
    }
  },
  // Долгие прогоны тестов копят огромные tool-выходы — вычищаем их из контекста.
  "compaction": {
    "prune": true
  },
  "skills": {
    "paths": [
      "./.windsurf/skills"
    ]
  },
  "mcp": {
    "yandex-tracker": {
      "type": "local",
      "command": [
        "uvx",
        "yandex-tracker-mcp@latest"
      ]
    },
    "yandex-wiki": {
      "type": "local",
      "command": [
        "uvx",
        "yandex-wiki-search-mcp@latest"
      ]
    },
    "grafana": {
      "type": "local",
      "command": [
        "uvx",
        "mcp-grafana"
      ]
    },
    "github": {
      "type": "local",
      "command": [
        "docker",
        "run",
        "-i",
        "--rm",
        "-e",
        "GITHUB_PERSONAL_ACCESS_TOKEN",
        "-e",
        "GITHUB_TOOLSETS",
        "ghcr.io/github/github-mcp-server"
      ],
      "environment": {
        "GITHUB_TOOLSETS": "repos,issues,pull_requests"
      }
    },
    "postgres": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "@tejasanik/postgres-mcp-server"
      ]
    }
  },
  // Агенты работают каждый в своём слоте (/work/slot-N). Выход наружу (соседние слоты —
  // чужие задачи, /work и т.д.) запрещаем, иначе opencode спрашивает разрешение (action=ask)
  // и асинхронный агент навсегда зависает в ожидании ответа (инцидент 8ac18ac3). /tmp нужен
  // для логов тестов (/tmp/x.log), поэтому его разрешаем явно.
  "permission": {
    "external_directory": {
      "*": "deny",
      "/tmp/**": "allow"
    }
  }
}
