{
  "$schema": "https://opencode.ai/config.json",
  "provider": {
    "deepseek": {
      "name": "DeepSeek",
      "options": {
        "baseURL": "https://api.deepseek.com",
        // Запрос к модели не дольше 10 мин, и не более 2 мин паузы между чанками стрима.
        // Залипший вызов DeepSeek рвётся сайдкаром → оркестратор видит ошибку и ретраит узел
        // (иначе ран висел до opencode.timeout-seconds вслепую).
        "timeout": 600000,
        "chunkTimeout": 120000
      },
      "models": {
        "deepseek-v4-pro": {},
        "deepseek-flash": {}
      }
    }
  },
  // Долгие прогоны тестов копят огромные tool-выходы — вычищаем их из контекста.
  "compaction": {
    "prune": true
  },
  "skills": {
    "paths": [
      "./.windsurf/skills"
    ]
  },
  "mcp": {
    "yandex-tracker": {
      "type": "local",
      "command": [
        "uvx",
        "yandex-tracker-mcp@0.10.0"
      ]
    },
    "yandex-wiki": {
      "type": "local",
      "command": [
        "uvx",
        "yandex-wiki-search-mcp@1.5.1"
      ]
    },
    "grafana": {
      "type": "local",
      "command": [
        "uvx",
        "mcp-grafana@2.0.0"
      ],
      // URL — не секрет, фиксируем явно, чтобы сайдкар не зависел от того, есть ли
      // GRAFANA_URL в .env на VPS (иначе mcp-grafana стартует с пустым URL и Grafana-тулов нет).
      // Токен по-прежнему берётся из окружения контейнера (docker-compose, из .env).
      "environment": {
        "GRAFANA_URL": "https://allstreeets.grafana.net"
      }
    },
    "github": {
      "type": "local",
      "command": [
        "docker",
        "run",
        "-i",
        "--rm",
        "-e",
        "GITHUB_PERSONAL_ACCESS_TOKEN",
        "-e",
        "GITHUB_TOOLSETS",
        "ghcr.io/github/github-mcp-server"
      ],
      "environment": {
        "GITHUB_TOOLSETS": "repos,issues,pull_requests"
      }
    },
    "postgres": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "@tejasanik/postgres-mcp-server"
      ]
    }
  },
  // Агенты работают каждый в своём слоте (/work/slot-N). Выход наружу (соседние слоты —
  // чужие задачи, /work и т.д.) запрещаем, иначе opencode спрашивает разрешение (action=ask)
  // и асинхронный агент навсегда зависает в ожидании ответа (инцидент 8ac18ac3). /tmp нужен
  // для логов тестов (/tmp/x.log), поэтому его разрешаем явно.
  "permission": {
    "external_directory": {
      "*": "deny",
      "/tmp/**": "allow"
    },
    // Чтение разрешаем полностью: агент живёт в изолированном контейнере (/work/slot-N), реальных
    // секретов (.env) в клонируемых репо нет — он в .gitignore, в образ jar-only нет opencode-config.
    // Дефолт opencode для *.env* — «ask», что в async-режиме вешало сессию до opencode.timeout-seconds
    // (инцидент 3e90880c: developer завис на read .env.template). Явный allow перебивает этот ask.
    "read": {
      "*": "allow",
      "*.env": "allow",
      "*.env.*": "allow"
    },
    // Повтор одинакового tool-вызова 3 раза подряд: дефолт opencode — «ask», а отвечать на
    // permission-запрос в async-режиме некому → агент завис бы до opencode.timeout-seconds.
    // Явный deny — повтор просто блокируется, агент идёт дальше, а не ждёт ответа.
    "doom_loop": "deny"
  }
}
