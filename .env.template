# ─── Secrets (остальное — в application.yml) ───

# DeepSeek API
DEEPSEEK_API_KEY=your_deepseek_api_key

# Telegram Bot
TELEGRAM_BOT_TOKEN=your_telegram_bot_token

# GitHub
GITHUB_TOKEN=your_github_personal_access_token

# Yandex Tracker MCP
TRACKER_TOKEN=your_yandex_tracker_token
TRACKER_CLOUD_ORG_ID=your_cloud_org_id

# Grafana MCP
GRAFANA_SERVICE_ACCOUNT_TOKEN=your_grafana_service_account_token

# PostgreSQL
POSTGRES_USER=developer
POSTGRES_PASSWORD=developer

# PostgreSQL MCP (@tejasanik/postgres-mcp-server)
# Server 1 — test
PG_NAME_1=allstreets-backend-prod
PG_HOST_1=postgres
PG_PORT_1=5432
PG_USERNAME_1=developer
PG_PASSWORD_1=developer
PG_DATABASE_1=agent_state
PG_SSL_1=false
PG_DEFAULT_1=true
# Server-level: readonly | full | rw
PG_ACCESS_MODE_1=readonly
# Per-DB: dbname:readonly,dbname:full,dbname:rw
PG_DB_ACCESS_MODES_1=agent_state:readonly

# Server 2 — prod
PG_NAME_2=allstreets-backend-prod
PG_HOST_2=
PG_PORT_2=5432
PG_USERNAME_2=
PG_PASSWORD_2=
PG_DATABASE_2=
PG_SSL_2=false
PG_DEFAULT_2=false
PG_ACCESS_MODE_2=readonly
# Example: prod_db:readonly,analytics_db:full,staging_db:rw
PG_DB_ACCESS_MODES_2=

# Loki (Grafana Cloud)
LOKI_HOST=your_loki_host
LOKI_USERNAME=your_loki_username
LOKI_PASSWORD=your_loki_password

# ─── Grafana Alloy → Grafana Cloud (remote_write) ───
ALLOY_REMOTE_WRITE_URL=your_grafana_remote_write_url
ALLOY_REMOTE_WRITE_USER=your_grafana_user_id
ALLOY_REMOTE_WRITE_TOKEN=your_grafana_auth_token
