# ─── Secrets (остальное — в application.yml) ───

# DeepSeek API
DEEPSEEK_API_KEY=your_deepseek_api_key

# Telegram Bot
TELEGRAM_BOT_TOKEN=your_telegram_bot_token

# GitHub
GITHUB_TOKEN=your_github_personal_access_token

# Yandex Tracker MCP
TRACKER_TOKEN=your_yandex_tracker_token
TRACKER_CLOUD_ORG_ID=your_cloud_org_id

# Grafana MCP
GRAFANA_SERVICE_ACCOUNT_TOKEN=your_grafana_service_account_token

# PostgreSQL
POSTGRES_USER=developer
POSTGRES_PASSWORD=developer

# Loki (Grafana Cloud)
LOKI_HOST=your_loki_host
LOKI_USERNAME=your_loki_username
LOKI_PASSWORD=your_loki_password

# ─── Grafana Alloy → Grafana Cloud (remote_write) ───
ALLOY_REMOTE_WRITE_URL=your_grafana_remote_write_url
ALLOY_REMOTE_WRITE_USER=your_grafana_user_id
ALLOY_REMOTE_WRITE_TOKEN=your_grafana_auth_token
DEVELOPER_ADDRESS=developer:8081
